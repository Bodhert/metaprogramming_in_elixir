```

```elixir
# Ai feedback
defmodule ExerciseOneAiFeedback do
  defmacro customUnless(expr, do: block) do
    quote do
      case unquote(expr) do
        nil -> unquote(block)
        false -> unquote(block)
        _ -> nil
      end
    end
  end
end
```

<!-- livebook:{"output":true} -->

```
{:module, ExerciseOneAiFeedback, <<70, 79, 82, 49, 0, 0, 8, ...>>, ...}
```

```elixir
require ExerciseOneAiFeedback

ExerciseOneAiFeedback.customUnless 5 do
  "should not print"
end
```

<!-- livebook:{"output":true} -->

```
nil
```

```elixir
defmodule ExerciseOneAiFeedbackWithElse do
  defmacro customUnless(expr, do: block, else: else_block) do
    quote do
      case unquote(expr) do
        nil -> unquote(block)
        false -> unquote(block)
        _ -> unquote(else_block)
      end
    end
  end
end
```

<!-- livebook:{"output":true} -->

```
{:module, ExerciseOneAiFeedbackWithElse, <<70, 79, 82, 49, 0, 0, 8, ...>>, ...}
```

```elixir
require ExerciseOneAiFeedbackWithElse
ExerciseOneAiFeedbackWithElse.customUnless 5 do
  "should not print"
else
 "should print"
end
```

<!-- livebook:{"output":true} -->

```
"should print"
```
