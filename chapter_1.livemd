macros recieves ast and returns ast (abstrac syntax tree)

```elixir
quote do: 1*3+3
```

<!-- livebook:{"output":true} -->

```
{:+, [context: Elixir, imports: [{1, Kernel}, {2, Kernel}]],
 [{:*, [context: Elixir, imports: [{2, Kernel}]], [1, 3]}, 3]}
```

```elixir
defmodule Math do
  defmacro say({:+, _, [lhs, rhs]}) do
    quote do
      lhs = unquote(lhs)
      rhs = unquote(rhs)
      result = lhs + rhs
      IO.puts "#{lhs} plus #{rhs} == #{result}"
      # result
    end 
  end

  defmacro say({:*, _, [lhs, rhs]}) do
    quote do
      lhs = unquote(lhs)
      rhs = unquote(rhs)
      result = lhs * rhs
      IO.puts "#{lhs} times #{rhs} == #{result}"
      result
    end
  end


  # this will puts "test" tree times since it is being baked into the ast
  defmacro test do
    quote do
      IO.puts("test")
      3
    end
  end

  ## even if it is a macro it will only prints one test
  defmacro unquoted_test do
      IO.puts("test")
      3
  end
end
```

<!-- livebook:{"output":true} -->

```
{:module, Math, <<70, 79, 82, 49, 0, 0, 16, ...>>, ...}
```

```elixir
require Math

# for _ <- 1..3, do: Math.test
# for _ <- 1..3, do: Math.unquoted_test

```

